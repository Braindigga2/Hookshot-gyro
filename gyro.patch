+void hos_sdl_pad_sensors_on(void *pad_ptr) {
+    hos_sdl_pad_t *pad = (hos_sdl_pad_t *)pad_ptr;
+    if (!pad || !pad->PadOpened || !pad->PadInstance) return;
+    
+    typedef int (*SDL_GamepadSetSensorEnabled_t)(void *, int, int);
+    SDL_GamepadSetSensorEnabled_t set_sensor = (SDL_GamepadSetSensorEnabled_t)pad->PadSensorOn;
+    if (set_sensor) {
