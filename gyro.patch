+    }
+}
+
+int hos_sdl_pad_sensor(void *pad_ptr, int type, float *data, int n) {
+    hos_sdl_pad_t *pad = (hos_sdl_pad_t *)pad_ptr;
+    if (!pad || !pad->PadOpened || !pad->PadInstance) return -1;
+    
+    typedef int (*SDL_GamepadGetSensorData_t)(void *, int, float *, int);
+    SDL_GamepadGetSensorData_t get_sensor = (SDL_GamepadGetSensorData_t)pad->PadSensorData;
+    if (get_sensor) {
+        return get_sensor(pad->PadInstance, type, data, n);
+    }
+    return -1;
+}
